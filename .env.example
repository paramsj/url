# ==============================================================================
# REQUIRED CONFIGURATION (Application will not start without these)
# ==============================================================================

# PostgreSQL connection string (Supabase, Neon, or local database)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# JWT secrets for signing and verifying user tokens
ACCESS_TOKEN_SECRET=your-strong-access-token-secret-here
REFRESH_TOKEN_SECRET=your-strong-refresh-token-secret-here

# ==============================================================================
# OPTIONAL CONFIGURATION (Sensible defaults are used if omitted)
# ==============================================================================

# Environment mode: 'development' | 'production'
# In 'production', auth cookies require HTTPS (secure: true)
NODE_ENV=development

# Redis Connection URL
# - Local development (without Docker): redis://localhost:6379
# - Docker Compose: Automatically overridden to redis://redis:6379
REDIS_URL=redis://localhost:6379

# Allowed CORS origins (comma-separated)
# Defaults to: http://localhost:3000,http://localhost
CORS_ORIGIN=http://localhost:3000,http://localhost

# Token lifespans (default: 15m and 7d)
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Standalone server settings (overridden automatically in Docker Compose and npm run dev:apps)
PORT=3000
SERVER_ID=app1
